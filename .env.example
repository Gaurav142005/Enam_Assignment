# Copy to .env (repo root). Never commit .env.

# web → api (server-side fetches and the /api rewrite)
API_URL=http://localhost:8000

# api
FINN_WEB_ORIGINS=http://localhost:3000

# LLM (optional; the pipeline runs rules-only without it).
# Free option A, Google Gemini: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free option B, any OpenAI-compatible API (Groq, OpenRouter, local Ollama):
# FINN_LLM_PROVIDER=openai
# FINN_LLM_BASE_URL=https://api.groq.com/openai/v1
# FINN_LLM_API_KEY=
# Model routing (defaults shown for Gemini)
# FINN_CHEAP_MODEL=gemini-2.5-flash-lite
# FINN_STRONG_MODEL=gemini-2.5-flash
